# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=5000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_agent

# ---------------------------------------------------------------------------
# Token encryption at rest (Fernet key).
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a key is derived from SECRET_KEY (fine for dev, not for prod).
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# GitHub OAuth App  (Settings -> Developer settings -> OAuth Apps)
# Authorization callback URL must match GITHUB_OAUTH_REDIRECT_URI exactly.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/auth/github/callback
GITHUB_OAUTH_SCOPES=repo read:user
# Where the browser lands after a successful callback (optional)
OAUTH_SUCCESS_REDIRECT=

# ---------------------------------------------------------------------------
# GitHub MCP server (remote, hosted by GitHub)
# ---------------------------------------------------------------------------
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Comma separated subset of MCP toolsets to expose. "all" exposes everything.
GITHUB_MCP_TOOLSETS=context,repos,issues,pull_requests
GITHUB_MCP_READONLY=false

# ---------------------------------------------------------------------------
# LLM  (pluggable -- swap provider/model without touching code)
# provider: openai | anthropic | google | ollama | groq | azure_openai
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# How many previous messages of the chat are replayed as context
CHAT_HISTORY_LIMIT=3
# Max agent<->tool round trips per request
AGENT_RECURSION_LIMIT=40
AGENT_TIMEOUT_SECONDS=300
# branch_pr | direct_commit  -- how the agent is instructed to apply changes
AGENT_WRITE_MODE=branch_pr
